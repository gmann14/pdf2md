{
  "name": "@pdf2md/core",
  "version": "0.4.0",
  "description": "Convert PDF files to Markdown — client-side and Node.js",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pdf",
    "markdown",
    "pdf-to-markdown",
    "converter",
    "typescript",
    "pdf-parser",
    "cli",
    "npm-package",
    "parser",
    "text-extraction"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist/cjs/compat.d.ts",
        "default": "./dist/cjs/compat.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/cjs/types.d.ts",
        "default": "./dist/cjs/types.js"
      }
    }
  },
  "bin": {
    "pdf2md": "./dist/bin/pdf2md.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fidelity": "vitest run --config vitest.corpus.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pdfjs-dist": "^5.2.133"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "jsdom": "^29.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
