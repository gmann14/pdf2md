{
  "name": "pdf2md",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @pdf2md/web dev",
    "build": "pnpm --filter @pdf2md/core build && pnpm --filter @pdf2md/web build",
    "test": "pnpm -r test",
    "test:corpus-smoke": "pnpm --filter @pdf2md/core exec vitest run src/corpus-smoke.test.ts",
    "test:fidelity": "pnpm --filter @pdf2md/core test:fidelity",
    "lint": "pnpm --filter @pdf2md/web lint",
    "typecheck": "pnpm --filter @pdf2md/core typecheck && pnpm --filter @pdf2md/mcp typecheck && pnpm --filter @pdf2md/web typecheck",
    "compare:opendocsg": "tsx --require ./test-corpus/node-polyfills.cjs test-corpus/compare-converters.ts",
    "bench": "pnpm --filter @pdf2md/core build && tsx bench/run.ts",
    "test:reference": "tsx --require ./test-corpus/node-polyfills.cjs test-corpus/reference/run.ts --failures",
    "check:headings": "tsx --require ./test-corpus/node-polyfills.cjs test-corpus/headings.ts"
  },
  "version": "",
  "devDependencies": {
    "@opendocsg/pdf2md": "0.3.6",
    "@types/markdown-it": "^14.2.0",
    "markdown-it": "^14.3.3",
    "tsx": "4.21.0"
  }
}
